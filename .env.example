# Postgres connection string. On Vercel: create a Neon or Vercel Postgres
# database from the Storage tab and it will populate this for you.
DATABASE_URL="postgresql://user:password@host:5432/campsync?sslmode=require"

# National Park Service API — free, instant key.
# https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=""

# RIDB (Recreation Information Database) — free key, official metadata
# for NPS/Forest Service/BLM/Army Corps campgrounds. Does NOT include
# live booking availability (see recreationAvailability.ts for why).
# Sign in at https://ridb.recreation.gov and find the key under your
# account menu (the old direct /landing/account/keys URL is dead).
RIDB_API_KEY=""

# No key needed for trail data (OpenStreetMap Overpass API), geocoding
# (OpenStreetMap Nominatim), or the unofficial recreation.gov availability
# endpoint — all three are called directly with no signup. See
# src/lib/providers/osmTrails.ts and recreationAvailability.ts for the
# tradeoffs each one comes with.
